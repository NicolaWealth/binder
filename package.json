{
  "name": "@nicolawealth/binder",
  "version": "0.0.2",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "types": "./dist/types/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "require": "./dist/index.umd.js",
      "import": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist/"
  ],
  "author": "Nicola Wealth Inc",
  "contributors": [
    {
      "name": "Cliff Hammerschmidt"
    },
    {
      "name": "Skye Haik"
    },
    {
      "name": "Travis Rempel"
    },
    {
      "name": "Mel Delosada"
    }
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist/* && rm -f tsconfig.tsbuildinfo",
    "build": "rollup -c && tsc -p tsconfig.types.json",
    "lint": "eslint src",
    "test": "mocha",
    "test-r": "mocha -R spec",
    "cover": "nyc mocha",
    "cover:report": "nyc --reporter=html --reporter=lcov --reporter=text --reporter=json mocha -c --reporter=spec",
    "doc": "npx typedoc src/*.ts src/**/*.ts --out dist/doc"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@nicolawealth/code_coverage_extractor": "^2",
    "@rollup/plugin-typescript": "^12",
    "tslib": "^2.8.1",
    "@types/mocha": "^10",
    "@types/node": "^22",
    "@types/sinon": "^10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "eslint": "^8.57.1",
    "eslint-config-turbo": "^2",
    "mocha": "^12",
    "nyc": "^18.0.0",
    "rollup": "^4",
    "sinon": "^22.1.0",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.0",
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
